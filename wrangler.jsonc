{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sillage",
  "compatibility_date": "2026-07-06",
  "observability": {
    "enabled": true
  },
  // Il sito: i file del repo, serviti così come sono. Solo /api passa dal
  // ponte (ponte/ponte.js), che collega l'app al database.
  "main": "ponte/ponte.js",
  "assets": {
    "directory": ".",
    "run_worker_first": ["/api", "/api/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Il database. Senza database_id Cloudflare lo crea da solo alla prima
  // pubblicazione; l'id resta visibile solo nel pannello di Cloudflare.
  "d1_databases": [
    { "binding": "DB", "database_name": "sillage" }
  ],
  // Ogni 5 minuti il ponte rilegge il foglio e manda al foglio quello che gli manca.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Le variabili messe a mano nel pannello di Cloudflare (come la chiave) restano
  // anche dopo ogni pubblicazione: senza, Cloudflare cancellerebbe quelle di tipo Text.
  "keep_vars": true,
  "vars": {
    // Il Web App del foglio: il ponte lo usa per leggere il foglio e per copiarci diario e residuo.
    "FOGLIO_URL": "https://script.google.com/macros/s/AKfycbz6i7ZF6FNBboUYZdKjJi1oS_dcbjtEdsCsGyrCxkVKNKIq61j7-H14N8zhDWpOr7w1og/exec",
    // "foglio": comanda il foglio, il database ne è una copia. "database": diario e
    // residuo li comanda il database, il foglio ne riceve una copia. Vedi ponte/LEGGIMI.md.
    "PADRONE": "database"
  }
  // La chiave di Sillage è un segreto (SILLAGE_CHIAVE), impostato nel pannello di
  // Cloudflare: Workers ▸ sillage ▸ Settings ▸ Variables and Secrets.
}
